OPENBKN_PUBLIC_BASE_URL=http://localhost:8080
OPENBKN_BIND_ADDRESS=127.0.0.1
OPENBKN_HTTP_PORT=8080
# 应用镜像 tag：镜像名固定为 openbkn/<service>:<tag>，离线打包时按它导出与核对。
OPENBKN_IMAGE_TAG=local
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT
MARIADB_PASSWORD=CHANGE_ME_MARIADB
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
REDIS_PASSWORD=CHANGE_ME_REDIS
KAFKA_USER=openbkn
KAFKA_PASSWORD=CHANGE_ME_KAFKA
HYDRA_SECRETS_SYSTEM=CHANGE_ME_HYDRA
BKN_SAFE_INITIAL_PASSWORD=CHANGE_ME_SAFE_INITIAL
MINIO_ROOT_USER=openbkn
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
OSS_CRYPTO_AES_KEY=CHANGE_ME_32_BYTE_AES_KEY
BKN_TRACE_EVIDENCE_INGEST_TOKEN=CHANGE_ME_TRACE_TOKEN
BKN_TRACE_ARTIFACT_INGEST_TOKEN=CHANGE_ME_TRACE_ARTIFACT_TOKEN
BKN_PROVENANCE_BOOTSTRAP_TOKEN=CHANGE_ME_PROVENANCE_TOKEN
OPENSEARCH_PASSWORD=CHANGE_ME_OPENSEARCH
