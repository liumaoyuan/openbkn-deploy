# ==========================================================================
# OpenBKN Docker 部署配置
#
# 这是唯一的配置入口：应用服务使用的配置文件由 config-init 在启动时
# 根据本文件自动生成，不需要手工编辑 config/ 目录。
#
# 修改后执行: docker compose --env-file .env up -d
#
# 填写规则:
#   1. 所有 CHANGE_ME_* 必须替换成自己的密码，建议 32 位以上
#   2. 密码不要包含空格和 #，否则会被解析截断
#   3. 密码第一次启动后就写进数据库/对象存储了，之后再改这里不会自动轮换
#   4. 本文件包含全部密码，不要提交到代码仓库，也不要外传
# ==========================================================================

# ---------- 访问地址 ----------
# 浏览器访问 OpenBKN 的完整地址。
# 必须与实际访问的 IP/域名、端口、协议完全一致，否则登录会失败或页面反复刷新。
# 内网机部署示例: http://192.168.1.100:8080
OPENBKN_PUBLIC_BASE_URL=http://localhost:8080

# 网关监听地址。127.0.0.1 只允许本机访问；要让其他机器访问必须改成 0.0.0.0。
OPENBKN_BIND_ADDRESS=127.0.0.1

# 网关对外端口，必须与上面地址里的端口一致。
OPENBKN_HTTP_PORT=8080

# ---------- 镜像 ----------
# 应用镜像 tag：镜像名固定为 openbkn/<service>:<tag>，离线打包和导入时按它核对。
# 本地构建用 local；按批次分发时可以改成版本号。
OPENBKN_IMAGE_TAG=local

# ---------- 数据库 ----------
# MariaDB 超级管理员密码，只在首次初始化数据目录时使用。
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT

# MariaDB 业务账号 openbkn 的密码，所有应用服务用它连接数据库。
MARIADB_PASSWORD=CHANGE_ME_MARIADB

# PostgreSQL 密码，OAuth 服务 Hydra 使用。
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# ---------- 缓存与消息队列 ----------
# Redis 密码。
REDIS_PASSWORD=CHANGE_ME_REDIS

# Kafka 账号，一般保持 openbkn 不要改。
KAFKA_USER=openbkn

# Kafka 密码。
KAFKA_PASSWORD=CHANGE_ME_KAFKA

# ---------- 对象存储 ----------
# MinIO 账号，一般保持 openbkn 不要改。
MINIO_ROOT_USER=openbkn

# MinIO 密码。
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO

# 对象存储加密密钥，必须正好 32 个字符。
# 服务启动后不要再改：已写入的数据是用旧密钥加密的。
OSS_CRYPTO_AES_KEY=CHANGE_ME_32_BYTE_AES_KEY

# ---------- 身份认证 ----------
# Hydra 内部签名密钥，用任意长随机串即可。
HYDRA_SECRETS_SYSTEM=CHANGE_ME_HYDRA

# 初始管理员 admin 的密码，只在第一次启动创建账号时生效。
# 登录后请尽快在界面里修改；之后再改这里不会影响已有账号。
BKN_SAFE_INITIAL_PASSWORD=CHANGE_ME_SAFE_INITIAL

# ---------- 内部服务令牌 ----------
# 服务间调用令牌，生成随机串即可，不需要记住。
BKN_TRACE_EVIDENCE_INGEST_TOKEN=CHANGE_ME_TRACE_TOKEN

# 同上。
BKN_TRACE_ARTIFACT_INGEST_TOKEN=CHANGE_ME_TRACE_ARTIFACT_TOKEN

# 同上。
BKN_PROVENANCE_BOOTSTRAP_TOKEN=CHANGE_ME_PROVENANCE_TOKEN

# ---------- 搜索引擎 ----------
# OpenSearch 密码。开发栈关闭了安全插件，但仍建议设置强密码。
OPENSEARCH_PASSWORD=CHANGE_ME_OPENSEARCH
